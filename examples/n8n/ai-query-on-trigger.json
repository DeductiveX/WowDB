{
  "name": "WowDB → AI-driven Query (NL→SQL→JSON)",
  "nodes": [
    {
      "parameters": { "path": "ai-query", "options": {} },
      "id": "webhook-1",
      "name": "Webhook (NL Input)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "wowdb-ai-query"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:8000/api/connections/1/ai-context?database={{$json.body.database || 'mydb'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "wdb_YOUR_KEY_HERE" },
            { "name": "X-DB-Password", "value": "YOUR_DB_PASSWORD" }
          ]
        },
        "options": {}
      },
      "id": "schema-1",
      "name": "Get schema context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer YOUR_OPENAI_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\"role\":\"system\",\"content\":\"Return ONLY a read-only SQL query (SELECT). Schema:\\n\" + JSON.stringify($json) },\n    {\"role\":\"user\",\"content\": $('Webhook (NL Input)').first().json.body.question }\n  ]\n}",
        "options": {}
      },
      "id": "ai-1",
      "name": "Generate SQL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "wdb_YOUR_KEY_HERE" },
            { "name": "X-DB-Password", "value": "YOUR_DB_PASSWORD" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"connection_id\": 1, \"query\": $json.choices[0].message.content.replace(/```sql/gi,'').replace(/```/g,'').trim() }",
        "options": {}
      },
      "id": "run-1",
      "name": "Run SQL on WowDB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook (NL Input)": {
      "main": [[ { "node": "Get schema context", "type": "main", "index": 0 } ]]
    },
    "Get schema context": {
      "main": [[ { "node": "Generate SQL", "type": "main", "index": 0 } ]]
    },
    "Generate SQL": {
      "main": [[ { "node": "Run SQL on WowDB", "type": "main", "index": 0 } ]]
    }
  },
  "settings": {},
  "active": false
}
