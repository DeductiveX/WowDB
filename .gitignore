# ─────────────────────────────────────────────
#  WowDB · .gitignore
# ─────────────────────────────────────────────

# ── Secrets & environment ─────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
secrets/

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# ── Database files (never commit!) ────────────
*.db
*.sqlite
*.sqlite3

# ── FastAPI / Uvicorn ─────────────────────────
*.pid

# ── Testing & coverage ────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.mypy_cache/
.dmypy.json
.ruff_cache/

# ── Node / Next.js ────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel/

# ── Misc OS files ─────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Editor / IDE ──────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace

# ── Logs ──────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Docker volumes (local data) ───────────────
mysql-data/
api-data/

# ── OS temp ───────────────────────────────────
tmp/
temp/
