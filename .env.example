# ─────────────────────────────────────────────
#  WowDB · Environment Variables Example
#  Copy this file to .env and fill in values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# SQLite path for internal WowDB metadata
WOWDB_DB_PATH=./wowdb.db

# Default query limit (rows)
DEFAULT_QUERY_LIMIT=100

# Query timeout in seconds
QUERY_TIMEOUT=10

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Demo MySQL (used by Docker Compose only)
DEMO_MYSQL_HOST=mysql-demo
DEMO_MYSQL_PORT=3306
DEMO_MYSQL_DB=creditdb
DEMO_MYSQL_USER=demo_user
DEMO_MYSQL_PASSWORD=demo_pass123

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
